meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{mockServiceUrl}}/api/core/v1/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns mock service health", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.available).to.be.a("boolean");
  });
}
