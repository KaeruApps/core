meta {
  name: Roles
  type: http
  seq: 2
}

get {
  url: {{mockServiceUrl}}/api/v1/system/roles
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("returns the mock role catalog", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.roles).to.be.an("array").and.have.length(3);
    expect(body.roles.map((role) => role.key)).to.include.members(["viewer", "editor", "admin"]);
  });
}
