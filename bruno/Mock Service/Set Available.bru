meta {
  name: Set Available
  type: http
  seq: 5
}

put {
  url: {{mockServiceUrl}}/api/v1/dev/availability
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "available": true
  }
}

tests {
  test("sets the mock service available", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.available).to.equal(true);
  });
}
