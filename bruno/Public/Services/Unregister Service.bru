meta {
  name: Unregister Service
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/services/{{serviceId}}/unregister
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("unregisters the service without deleting its configuration", function () {
    const body = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(body.id).to.equal(bru.getVar("serviceId"));
    expect(body.registration_status).to.equal("unregistered");
    expect(body.public_url).to.equal("https://upload.example.com");
    expect(body.database_name).to.equal("kaeru_upload");
  });
}
